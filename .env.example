# ============================================================
# Cloudland 环境变量模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入真实值（.env 不会被提交到 Git）
#   3. docker-compose up 时会自动加载 .env
# ============================================================

# ===== 数据库 =====
DB_PASSWORD=your-mysql-password

# ===== Redis =====
REDIS_PASSWORD=your-redis-password

# ===== JWT 签名密钥（建议 32 位以上随机字符串） =====
JWT_SIGN_KEY=your-jwt-sign-key

# ===== 邮件（QQ 邮箱授权码，非登录密码） =====
MAIL_PASSWORD=your-mail-authorization-code

# ===== 支付宝 =====
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-app-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key

# ===== 环境相关配置 =====
# 服务器部署：
CORS_ALLOWED_ORIGINS=http://your-server-ip
ALIPAY_NOTIFY_URL=http://your-server-ip/api/alipay/notify
ALIPAY_RETURN_URL=http://your-server-ip/user/myOrder
# 本地 docker-compose：
# CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080
# ALIPAY_NOTIFY_URL=http://localhost/api/alipay/notify
# ALIPAY_RETURN_URL=http://localhost/user/myOrder
