# ── 测试环境变量模板 ─────────────────────────────────────────────
# 收敛所有 TEST_* 变量；未设置时代码内含同样的默认值（tests/fixtures/seed.mjs、tests/helpers/*）
# 加载方式：playwright.config.js / seed.mjs 顶部 import tests/env.mjs 自动读取本文件
# 优先级：已存在的环境变量优先（CI 由 workflow 注入时，本文件不覆盖）
# 注意：不含 VUE_APP_ 前缀的变量不会被 Vue CLI 注入前端构建产物，无泄露风险

# 后端 API 地址（accounts.js / cleanup.js / auth.js 读取）
TEST_API_BASE_URL=http://localhost:9090/api

# MySQL 连接（seed.mjs 直连，用于种子账号）
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=123456
TEST_DB_NAME=cloudland

# Redis 连接（helpers/redis.js 直写验证码）
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_PASSWORD=123456
