# ======================================================================
# 换行符规范
# ----------------------------------------------------------------------
# 本项目在 Windows 上开发、在 Linux 服务器/容器中构建运行。
# 若不加约束，core.autocrlf 可能把 shell 脚本转成 CRLF，
# 而 Linux 上的 bash 遇到 CRLF 会直接报错：
#     bash\r: No such file or directory
# 这是容器/CI 场景里最典型、又最难定位的故障 —— 看不见字符，只见"文件不存在"。
# ======================================================================

# 默认：由 git 判断，入库统一为 LF
* text=auto eol=lf

# Shell 脚本必须是 LF
*.sh text eol=lf
*.bash text eol=lf

# 容器与编排文件必须是 LF
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker-compose.*.yml text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf

# nginx 配置必须是 LF
nginx.conf text eol=lf
*.conf text eol=lf

# CI 配置必须是 LF
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件不做任何转换
*.jar binary
*.war binary
*.sql text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
