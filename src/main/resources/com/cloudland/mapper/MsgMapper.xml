<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudland.mapper.MsgMapper">

    <select id="selectByCondition" resultType="com.cloudland.pojo.Msg">
        SELECT
            msg.*
        FROM
            msg
        <where>
            <!-- 根据条件动态添加查询条件 -->
            <if test="msg.id != null">
                AND msg.id = #{msg.id}
            </if>
            <if test="msg.name != null">
                AND msg.name LIKE CONCAT('%', #{msg.name}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>
</mapper>
